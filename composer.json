{
    "name": "mfonte/sparsedigest",
    "description": "Fast, deterministic file hashing for change detection: samples selected blocks of large binary files instead of reading them in full, and falls back to a full-file hash for text files. Not cryptographic.",
    "keywords": [
        "hash",
        "hashing",
        "file-hash",
        "sparse-hash",
        "sampling",
        "fingerprint",
        "checksum",
        "file-integrity",
        "change-detection",
        "binary-files",
        "performance",
        "fast-hash"
    ],
    "homepage": "https://github.com/mauriziofonte/sparsedigest",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Maurizio Fonte",
            "email": "fonte.maurizio@gmail.com",
            "homepage": "https://www.mauriziofonte.it",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/mauriziofonte/sparsedigest/issues",
        "source": "https://github.com/mauriziofonte/sparsedigest",
        "security": "https://github.com/mauriziofonte/sparsedigest/security/policy"
    },
    "require": {
        "php": "^7.2 || ^8.0",
        "ext-hash": "*"
    },
    "require-dev": {
        "ext-mbstring": "*",
        "friendsofphp/php-cs-fixer": "^3.4",
        "phpbench/phpbench": "^0.17 || ^1.2",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^8.5.21"
    },
    "suggest": {
        "ext-fileinfo": "Required by File::getMimeType() to detect MIME types; without it, \"application/octet-stream\" is returned."
    },
    "autoload": {
        "psr-4": {
            "Mfonte\\SparseDigest\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mfonte\\SparseDigest\\Test\\": "tests/",
            "Mfonte\\SparseDigest\\Benchmarks\\": "benchmarks/"
        }
    },
    "bin": [
        "bin/sparsedigest"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit --colors=always",
        "test:coverage": "@php vendor/bin/phpunit --coverage-text --coverage-clover=clover.xml",
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "cs:check": "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
        "cs:fix": "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "fix": "@cs:fix",
        "check": [
            "@cs:check",
            "@analyse",
            "@test"
        ],
        "bench": "@php vendor/bin/phpbench run --report=default",
        "bench:core": "@php vendor/bin/phpbench run --group=core --report=default",
        "bench:scaling": "@php vendor/bin/phpbench run --group=scaling --report=default",
        "bench:algorithms": "@php vendor/bin/phpbench run --group=algorithms --report=default",
        "bench:realworld": "@php vendor/bin/phpbench run --group=realworld --report=default",
        "bench:internals": "@php vendor/bin/phpbench run --group=internals --report=default"
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite.",
        "test:coverage": "Run the test suite with code coverage (requires Xdebug or PCOV).",
        "analyse": "Run PHPStan static analysis.",
        "cs:check": "Check coding style without changing files.",
        "cs:fix": "Fix coding style.",
        "check": "Run coding style, static analysis and tests."
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        }
    }
}
