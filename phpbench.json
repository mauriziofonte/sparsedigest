{
    "$schema": "https://phpbench.github.io/phpbench/phpbench.schema.json",
    "runner.bootstrap": "vendor/autoload.php",
    "runner.path": "benchmarks",
    "runner.file_pattern": "*Bench.php",
    "runner.php_config": {
        "memory_limit": "512M"
    },
    "runner.iterations": 5,
    "runner.revs": 10,
    "runner.retry_threshold": 5,
    "runner.warmup": 1
}
